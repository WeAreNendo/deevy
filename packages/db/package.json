{
  "name": "@deevy/db",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./relations": "./src/relations.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:auth": "auth generate --config ./auth.generate.config.ts --output ./src/schema/auth.ts -y",
    "generate": "drizzle-kit generate && node scripts/emit-d1-migrations.ts",
    "generate:d1": "node scripts/emit-d1-migrations.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "check:d1": "node scripts/check-d1-apply.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/cimd": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@types/node": "catalog:",
    "auth": "catalog:",
    "better-auth": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
