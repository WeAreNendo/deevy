  {
    "name": "gates_request",
    "operation": "gates.request",
    "summary": "Ask the Humans to let this Run past a Checkpoint, with what you intend to do",
    "readOnly": false,
    "agents": true,
    "agentsOnly": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "proposal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "links": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "title"
            ]
          }
        }
      },
      "required": [
        "runId",
        "checkpoint",
        "proposal"
      ]
    }
  },
  {
    "name": "inbox_list",
    "operation": "inbox.list",
    "summary": "The Notifications waiting for you, newest first",
    "readOnly": true,
    "agents": true,
    "agentsOnly": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "unreadOnly": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "before": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    }
  },
  {
    "name": "issues_create",
    "operation": "issues.create",
    "summary": "Open a record in the tracker a Project is bound to, and project it",
    "readOnly": false,
    "agents": true,
    "agentsOnly": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "body": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "assignAgent": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectSlug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,38}[a-z0-9]$"
        }
      },
      "required": [
        "title"
      ]
    }
  },
