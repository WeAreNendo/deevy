{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "WeAreNendo/deevy"
    }
  ],
  "commit": false,
  "format": false,
  "baseBranch": "main",
  "access": "restricted",
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": true,
    "tag": false
  },
  "fixed": [
    [
      "@deevy/core",
      "@deevy/db",
      "@deevy/adapters",
      "@deevy/sockets",
      "@deevy/email",
      "@deevy/design",
      "@deevy/web",
      "@deevy/server",
      "@deevy/agent",
      "@deevy/cli",
      "@deevy/hosted",
      "@deevy/release",
      "@deevy/acceptance"
    ]
  ],
  "ignore": ["@deevy/docs"],
  "changedFilePatterns": ["**", "!**/*.md", "!**/tests/**", "!**/*.test.ts"]
}
