# Copy to .env for local development. Never commit .env.

# Where the Node server listens. The SPA's dev proxy follows it, so moving this
# moves both halves of the dev loop — for a machine where something else holds
# the port, or a second checkout running at the same time. `DEEVY_API_ORIGIN`
# overrides where the proxy looks, for a server that is not on this machine.
DEEVY_PORT=3000
# SQLite database file (created and migrated on start). Use ":memory:" for a throwaway database.
DEEVY_DATABASE_PATH=./data/deevy.sqlite
# Public URL of the server; Better Auth derives its callback URLs from it.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters. Generate with: npx auth@1.7.3 secret
BETTER_AUTH_SECRET=
# What a connected tool's credentials are sealed with, at rest. At least 32 random characters, and not the
# same value as BETTER_AUTH_SECRET: signing everybody out by rotating that one must not also mean connecting
# every tool again. Losing this one does mean that, so back it up with the database file. Without it deevy
# refuses to connect a tool that holds a credential.
DEEVY_SECRET=
# GitHub's REST root for a Socket that names none of its own. A GitHub Enterprise Server is
# https://github.example.com/api/v3; github.com needs nothing here.
# DEEVY_GITHUB_API=
# How long a connected tool may say nothing before deevy asks it what changed. Polling is what keeps an
# instance no tool can reach — a laptop, anything behind a firewall — working at all.
DEEVY_SOCKET_CATCHUP_MINUTES=30
# Browser origin allowed to call the API with cookies (the Vite dev server). It is also where a link deevy
# hands a Human is built — a Gate, an invitation, a Slack message — so set it whenever the SPA is not served
# from BETTER_AUTH_URL.
DEEVY_WEB_ORIGIN=http://localhost:5173
# GitHub OAuth App. Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client. Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# Set both halves or neither; a provider with only half a pair is not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitLab application. Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/gitlab
# Scopes read_user and read_api; read_api is what lists a sign-in's groups for a gitlab_group rule.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# A self-hosted GitLab, if it is not gitlab.com. Every GitLab endpoint deevy calls is built from it.
# GITLAB_ISSUER=https://gitlab.example.com
# One generic OpenID Connect provider — Okta, Entra, Keycloak, Authentik. The issuer is where its
# well-known document hangs off; everything else is discovered from it. Redirect URI:
# ${BETTER_AUTH_URL}/api/auth/callback/oidc. The name is what the button says, "Single sign-on" unset.
# DEEVY_OIDC_ISSUER=https://idp.example.com/realms/acme
DEEVY_OIDC_CLIENT_ID=
DEEVY_OIDC_CLIENT_SECRET=
# DEEVY_OIDC_NAME=Acme SSO
# The first sign-in with this email becomes the Workspace admin and creates the Workspace.
DEEVY_ADMIN_EMAIL=
DEEVY_WORKSPACE_NAME=deevy
# Silence after which a Run is presumed stale, and how often the sweep looks.
DEEVY_RUN_STALE_MINUTES=30
DEEVY_SWEEP_INTERVAL_SECONDS=60
# Optional: directory of the built SPA to serve from the Node server.
# DEEVY_WEB_DIST=../web/dist
# Development only: replace every sign-in provider with the stub the tests sign in through, so no account
# anywhere is needed and any email signs in (the one in DEEVY_ADMIN_EMAIL becomes the admin). It supplies the
# client pairs too, so the four providers above can all stay empty and the page still offers all four
# buttons. Refused when NODE_ENV=production.
# The `dev:stub` launch configuration sets it, on its own database file, and
# `DEEVY_DATABASE_PATH=./data/stub.sqlite vp run server#seed` fills that database with a Workspace worth
# looking at (docs/DEVELOPMENT.md); without the prefix the seed writes to this file's DEEVY_DATABASE_PATH.
# DEEVY_DEV_STUB_OAUTH=1
