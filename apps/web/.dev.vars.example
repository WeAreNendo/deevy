# Copy to apps/web/.dev.vars for `wrangler dev`. Never commit .dev.vars.
#
# wrangler reads this file from the directory holding wrangler.jsonc, and it is
# the local stand-in for `wrangler secret put` on a deployment. The names are
# the ones apps/server reads from the environment; docs/OPERATIONS.md has the
# table of what each one does on either runtime.

# Public URL of the Worker; Better Auth derives its callback URLs from it, and
# the MCP challenge names it. Without it, deevy answers on whatever origin the
# request arrived at.
BETTER_AUTH_URL=http://localhost:8787
# At least 32 random characters. Generate with: npx auth@1.7.2 secret
BETTER_AUTH_SECRET=
# GitHub OAuth App. Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client. Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitLab application. Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/gitlab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# A self-hosted GitLab, if it is not gitlab.com.
# GITLAB_ISSUER=https://gitlab.example.com
# One generic OpenID Connect provider, discovered from its issuer. Redirect URI:
# ${BETTER_AUTH_URL}/api/auth/callback/oidc. DEEVY_OIDC_NAME is what the button says.
# DEEVY_OIDC_ISSUER=https://idp.example.com/realms/acme
DEEVY_OIDC_CLIENT_ID=
DEEVY_OIDC_CLIENT_SECRET=
# DEEVY_OIDC_NAME=Acme SSO
# Microsoft Entra ID. Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/microsoft
# A Microsoft address counts as verified only with the optional claims verified_primary_email and
# verified_secondary_email (docs/OPERATIONS.md). Tenant: common, organizations, or a tenant id.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Linear OAuth application (scope read). Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/linear
# Linear never says an address is verified, so a Linear sign-in comes in by invitation only.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Sign in with Slack (openid, email, profile). Redirect URL: ${BETTER_AUTH_URL}/api/auth/callback/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Atlassian app (read:me). Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/atlassian
# Atlassian never says an address is verified, so an Atlassian sign-in comes in by invitation only.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Email (docs/plans/email-channel.md): the sender deevy sends through and the address it sends as, whose
# domain the sender must have verified. Without them deevy sends no email; the inbox and Slack still work.
# DEEVY_EMAIL_SENDER=resend
# DEEVY_EMAIL_FROM=deevy <deevy@example.com>
# RESEND_API_KEY=
# The provider ids to offer first, in this order; the rest follow the default order.
# DEEVY_SIGN_IN_ORDER=oidc,github
# The first sign-in with this email becomes the Workspace admin and creates the Workspace.
DEEVY_ADMIN_EMAIL=
DEEVY_WORKSPACE_NAME=deevy
