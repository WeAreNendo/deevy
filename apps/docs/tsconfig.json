{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    // astro/client declares the virtual modules src/content.config.ts imports
    // (astro:content); the scripts are Node's.
    "types": ["node", "astro/client"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["astro.config.ts", "src", "scripts", "tests", "vite.config.ts"],
  "exclude": ["dist", "src/content/docs"]
}
