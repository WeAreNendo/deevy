---
/*
 * The landing's hero, in place of Starlight's (astro.config.ts): the title,
 * tagline and actions from content/index.mdx's `hero`, over the workflow
 * graph, one Issue's way through deevy (./home/workflow.ts). The graph is
 * drawn here, at build time, so the page is whole before any script runs; the
 * script below only animates it: the board flattens as it scrolls into view,
 * the wires draw themselves once, and one Run at a time travels them, waiting
 * at the Gate until a Human rules from one of the three channels.
 *
 * Set in Geist, bold, self-hosted like the site's other faces (Matt chose it
 * for this hero, 2026-10-22); the rest of the site stays in @deevy/design's.
 * Only the landing has a `hero`, so only the landing renders this.
 */
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import { LinkButton } from "@astrojs/starlight/components";
import { bar, disc, markBox } from "@deevy/design/logo";
import { box, nodes, ports, viewBox, wires } from "./home/workflow.ts";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const { width: w, height: h } = box;
---

<div class="home-hero not-content">
  <div class="copy">
    {/* Starlight's own id for the page title (PAGE_TITLE_ID), which the skip link targets. */}
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ icon, link: href, text, variant }) => (
            <LinkButton {href} variant={variant} icon={icon?.name}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>

  <div class="stage">
    <div class="board" data-workflow>
      <div class="board-bar" aria-hidden="true">
        <span class="pill">Workspace · acme</span>
        <span class="pill">Project · Billing</span>
        <span class="grow"></span>
        <span data-status>ENG-12 · waiting to start</span>
      </div>
      <div class="graph">
        <svg
          viewBox={`0 0 ${viewBox.width} ${viewBox.height}`}
          role="img"
          aria-label="An Issue assigned in Linear is routed by deevy to the Agent builder, which stops at its plan Checkpoint's Gate. A Human approves from deevy, a comment on the record or Slack; the pull request opens and Linear hears back."
        >
          <g class="wires">
            {
              wires.map((wire) => (
                <path d={wire.d} class:list={["wire", { loop: wire.loop }]} data-wire={wire.key} />
              ))
            }
          </g>
          <g class="nodes">
            {
              nodes.map((n) => (
                <g class={`node ${n.kind}`} transform={`translate(${n.x} ${n.y})`} data-node={n.id}>
                  <rect class="box" width={w} height={h} rx="12" />
                  {n.kind === "human" && <circle class="icon" cx="26" cy="32" r="11" />}
                  {n.kind === "agent" && (
                    <rect class="icon" x="15" y="21" width="22" height="22" rx="5" />
                  )}
                  {n.kind === "gate" && (
                    <rect class="icon" x="24" y="18" width="4" height="28" rx="2" />
                  )}
                  {n.kind === "tool" && <circle class="icon" cx="26" cy="32" r="11" />}
                  {n.kind === "deevy" && (
                    <svg x="14" y="18" width="24" height="28" viewBox={markBox}>
                      <path d={disc} class="disc" />
                      <path d={bar} class="bar" />
                    </svg>
                  )}
                  <text x="50" y="29" class="title">
                    {n.title}
                  </text>
                  <text x="50" y="47" class="detail">
                    {n.detail}
                  </text>
                </g>
              ))
            }
          </g>
          <g class="ports">{ports.map(([x, y]) => <circle cx={x} cy={y} r="4" />)}</g>
          <circle class="halo" r="12" cx={nodes[4]!.x + w / 2} cy={nodes[4]!.y + h} />
          <circle class="packet" r="6" cx={wires[0]!.from[0]} cy={wires[0]!.from[1]} />
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .home-hero {
    --hero-face: "Geist Variable", var(--face-sans);
    --hero-mono: "Geist Mono Variable", var(--face-mono);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(1.5rem, 6vw, 4.5rem);
    font-family: var(--hero-face);
    overflow-x: clip;
  }
  .home-hero::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 16rem;
    width: min(70rem, 120vw);
    height: 40rem;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, color-mix(in oklab, var(--primary) 20%, transparent), transparent);
    pointer-events: none;
  }
  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  h1 {
    margin: 0;
    max-width: 16ch;
    font-family: var(--hero-face);
    font-size: clamp(2.5rem, 6.2vw, 5.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--foreground);
    text-wrap: balance;
  }
  h1 :global(.gate) {
    color: var(--gate);
  }
  .tagline {
    margin: 0;
    max-width: 36rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .stage {
    position: relative;
    width: 100%;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    perspective: 1400px;
  }
  /* --flat is 1 at rest and without a script; the script tilts the board back and flattens it on scroll. */
  .board {
    --flat: 1;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in oklab, var(--card) 92%, var(--background));
    box-shadow: 0 60px 140px -50px color-mix(in oklab, var(--primary) 45%, transparent);
    overflow: clip;
    transform-origin: 50% 0;
    transform: rotateX(calc((1 - var(--flat)) * 28deg)) scale(calc(0.94 + var(--flat) * 0.06));
  }
  .board-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.25rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--hero-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
  .pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.125rem 0.625rem;
  }
  .grow {
    flex: 1;
  }
  .graph {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
  }

  .wire {
    fill: none;
    stroke: color-mix(in oklab, var(--muted-foreground) 55%, transparent);
    stroke-width: 1.5;
    transition: stroke 0.3s;
  }
  .wire.loop {
    stroke-dasharray: 4 6;
  }
  .wire.lit {
    stroke: var(--human);
  }
  .box {
    fill: var(--background);
    stroke: var(--border);
    transition: stroke 0.3s, fill 0.3s;
  }
  .gate .box {
    fill: color-mix(in oklab, var(--gate) 10%, var(--background));
    stroke: var(--gate);
  }
  .gate.asking .box {
    fill: color-mix(in oklab, var(--gate) 22%, var(--background));
  }
  .node.on .box {
    stroke: var(--human);
  }
  .icon {
    fill: none;
    stroke-width: 2;
  }
  .human .icon {
    stroke: var(--human);
  }
  .agent .icon {
    stroke: var(--agent);
  }
  .gate .icon {
    fill: var(--gate);
    stroke: none;
  }
  .tool .icon {
    stroke: var(--muted-foreground);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
  .disc {
    fill: var(--human);
  }
  .bar {
    fill: var(--agent);
  }
  .title {
    font-family: var(--hero-face);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    fill: var(--foreground);
  }
  .detail {
    font-family: var(--hero-mono);
    font-size: 11px;
    fill: var(--muted-foreground);
  }
  .ports circle {
    fill: var(--card);
    stroke: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
    stroke-width: 1.5;
  }
  .packet {
    fill: var(--human);
    opacity: 0;
  }
  .packet[data-kind="agent"] {
    fill: var(--agent);
  }
  .packet[data-kind="done"] {
    fill: var(--state-done);
  }
  .halo {
    fill: none;
    stroke: var(--gate);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (max-width: 50rem) {
    .board {
      transform: none;
    }
  }
</style>

<script>
  import { packetKind, route, status as statusOf } from "./home/workflow.ts";

  const board = document.querySelector<HTMLElement>("[data-workflow]");
  if (board) animate(board);

  function animate(board: HTMLElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const svg = board.querySelector("svg")!;
    const status = board.querySelector<HTMLElement>("[data-status]")!;
    const packet = svg.querySelector<SVGCircleElement>(".packet")!;
    const halo = svg.querySelector<SVGCircleElement>(".halo")!;
    const wires = new Map(
      [...svg.querySelectorAll<SVGPathElement>("[data-wire]")].map((p) => [p.dataset.wire!, p]),
    );
    const node = (id: string) => svg.querySelector<SVGGElement>(`[data-node="${id}"]`)!;
    if (reduce) return;

    // The board leans back until it scrolls into view, then lies flat.
    const stage = board.parentElement!;
    const flatten = () => {
      const top = stage.getBoundingClientRect().top;
      const vh = window.innerHeight;
      const flat = Math.min(1, Math.max(0, (vh * 0.85 - top) / (vh * 0.6)));
      board.style.setProperty("--flat", flat.toFixed(3));
    };
    flatten();
    window.addEventListener("scroll", () => requestAnimationFrame(flatten), { passive: true });
    window.addEventListener("resize", flatten);

    // Only walk the graph while it is on screen and the tab is visible.
    let onScreen = true;
    new IntersectionObserver(([entry]) => (onScreen = entry!.isIntersecting)).observe(board);
    const visible = () =>
      new Promise<void>((resolve) => {
        const check = () => (onScreen && !document.hidden ? resolve() : setTimeout(check, 300));
        check();
      });

    // The wires draw themselves once, in order, and stay whole.
    const all = [...wires.values()];
    for (const path of all) {
      const length = path.getTotalLength();
      path.style.strokeDasharray = `${length} ${length}`;
      path.style.strokeDashoffset = `${length}`;
    }
    for (const [i, g] of [...svg.querySelectorAll(".node")].entries()) {
      g.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, delay: i * 50, fill: "backwards" });
    }
    const drawn = all.map((path, i) =>
      path.animate([{ strokeDashoffset: path.getTotalLength() }, { strokeDashoffset: 0 }], {
        duration: 450,
        delay: 300 + i * 70,
        easing: "ease-in-out",
        fill: "forwards",
      }).finished,
    );
    Promise.all(drawn).then(() => {
      for (const path of all) {
        path.getAnimations().forEach((a) => a.cancel());
        path.style.strokeDasharray = "";
        path.style.strokeDashoffset = "";
      }
      void walk();
    });

    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    function travel(path: SVGPathElement): Promise<void> {
      const length = path.getTotalLength();
      const duration = Math.max(500, (length / 280) * 1000);
      return new Promise((resolve) => {
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          const point = path.getPointAtLength(ease(t) * length);
          packet.setAttribute("cx", String(point.x));
          packet.setAttribute("cy", String(point.y));
          if (t < 1) requestAnimationFrame(step);
          else resolve();
        };
        requestAnimationFrame(step);
      });
    }

    // One Run at a time: in, a wait at the Gate, out through a channel the last Run did not take.
    let last = "";
    async function walk() {
      for (;;) {
        await visible();
        const channels = Object.keys(route.channels).filter((c) => c !== last);
        const channel = channels[Math.floor(Math.random() * channels.length)]!;
        last = channel;
        const legs = [...route.in, ...route.channels[channel]!, ...route.out];
        packet.style.opacity = "1";
        for (const key of legs) {
          const path = wires.get(key)!;
          if (key.startsWith("gate>")) {
            status.textContent = "ENG-12 · waiting at the Gate";
            node("gate").classList.add("asking");
            await halo.animate(
              [
                { opacity: 0, transform: "scale(1)" },
                { opacity: 1, transform: "scale(2)" },
              ],
              { duration: 600, iterations: 4, direction: "alternate" },
            ).finished;
            node("gate").classList.remove("asking");
            node(channel).classList.add("on");
          }
          packet.dataset.kind = packetKind(key);
          status.textContent = `ENG-12 · ${statusOf[key]}`;
          path.classList.add("lit");
          await travel(path);
          path.classList.remove("lit");
          if (key.startsWith("gate>")) node(channel).classList.remove("on");
        }
        packet.style.opacity = "0";
        await new Promise((resolve) => setTimeout(resolve, 600));
      }
    }
  }
</script>
