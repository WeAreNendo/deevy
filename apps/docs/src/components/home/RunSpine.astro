---
/*
 * The Events one Run leaves on the record, in order, down a rail that fills
 * as it scrolls past; each kind is a real one (packages/core/src/events.ts)
 * in the colour of whoever made it.
 */
const events = [
  {
    kind: "issue.assigned",
    color: "var(--human)",
    title: "Someone gives ENG-12 to builder",
    text: "In Linear, the way they would assign a colleague.",
  },
  {
    kind: "run.started",
    color: "var(--agent)",
    title: "builder picks it up",
    text: "With the repository, the branch to cut and a short-lived credential.",
  },
  {
    kind: "gate.requested",
    color: "var(--gate)",
    title: "It stops at the plan Checkpoint",
    text: "A Proposal waits for a Human. A Checkpoint may want two of them.",
  },
  {
    kind: "gate.approved",
    color: "var(--human)",
    title: "Maya approves from Slack",
    text: "The Ruling records where it came from.",
  },
  {
    kind: "run.pull_request_opened",
    color: "var(--agent)",
    title: "deevy opens the pull request",
    text: "acme/billing#88, linked on the record.",
  },
  {
    kind: "run.completed",
    color: "var(--state-done)",
    title: "Linear hears back",
    text: "With the tokens and cost the Run reported, and how long it worked and waited.",
  },
];
---

<section class="spine not-content" aria-labelledby="one-run">
  <h2 id="one-run">What one Run leaves behind</h2>
  <div class="track" data-spine>
    <span class="rail" aria-hidden="true"><i data-fill></i></span>
    <ol class="list">
    {
      events.map((event) => (
        <li class="event" style={`--c: ${event.color}`}>
          <span class="dot" aria-hidden="true" />
          <code>{event.kind}</code>
          <h3>{event.title}</h3>
          <p>{event.text}</p>
        </li>
      ))
    }
    </ol>
  </div>
  <p class="more"><a href="/concepts/events/">How the Event log works</a></p>
</section>

<script>
  const list = document.querySelector<HTMLElement>("[data-spine]");
  if (list && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    list.classList.add("moving");
    const fill = list.querySelector<HTMLElement>("[data-fill]")!;
    const events = [...list.querySelectorAll<HTMLElement>(".event")];
    const update = () => {
      const rect = list.getBoundingClientRect();
      const line = window.innerHeight * 0.6;
      const progress = Math.min(1, Math.max(0, (line - rect.top) / rect.height));
      fill.style.height = `${progress * 100}%`;
      for (const event of events) event.classList.toggle("on", event.getBoundingClientRect().top < line);
    };
    update();
    window.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    window.addEventListener("resize", update);
  }
</script>

<style>
  .spine {
    margin-top: clamp(3rem, 8vw, 6rem);
    font-family: "Geist Variable", var(--face-sans);
  }
  h2 {
    margin: 0;
    text-align: center;
    font-family: inherit;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--foreground);
  }
  .track {
    position: relative;
    max-width: 46rem;
    margin: 3rem auto 0;
  }
  .list {
    margin: 0;
    padding: 0 0 0 3.5rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .rail {
    position: absolute;
    left: 0.9375rem;
    top: 0.375rem;
    bottom: 0.375rem;
    width: 2px;
    background: var(--border);
  }
  .rail i {
    position: absolute;
    inset: 0 0 auto;
    height: 100%;
    background: linear-gradient(var(--human), var(--agent), var(--gate), var(--state-done));
  }
  .event {
    position: relative;
  }
  .dot {
    position: absolute;
    left: -3.0625rem;
    top: 0.25rem;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--background);
    border: 2px solid var(--c);
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--c) 18%, transparent);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  /* With a script, the rail starts empty and each dot lights as it passes the line. */
  .moving .rail i {
    height: 0;
  }
  .moving .event:not(.on) .dot {
    border-color: var(--border);
    box-shadow: none;
  }
  code {
    font-family: "Geist Mono Variable", var(--face-mono);
    font-size: 0.8125rem;
    color: var(--c);
  }
  h3 {
    margin: 0.375rem 0 0;
    font-family: inherit;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--foreground);
  }
  .event p {
    margin: 0.375rem 0 0;
    color: var(--muted-foreground);
  }
  .more {
    margin: 2.5rem 0 0;
    text-align: center;
  }
  .more a {
    color: var(--link);
    text-underline-offset: 0.25em;
  }
</style>
