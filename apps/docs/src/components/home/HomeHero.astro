---
/*
 * The landing's hero (content/index.mdx renders it; src/components/Hero.astro
 * steps aside there): the title, tagline and actions from the page's `hero`,
 * over one Issue's way through deevy (./workflow.ts). The graph is drawn here,
 * at build time, so the page is whole before any script runs. The script only
 * animates it: the board flattens as it scrolls into view, the wires draw
 * themselves once, and one Run at a time travels them, waiting at the Gate
 * until a Human rules from one of the three channels. It pauses off screen, in
 * a hidden tab and from the board's own button, and stays still under reduced
 * motion. Set in Geist (./home.css).
 */
import { bar, disc, markBox } from "@deevy/design/logo";
import { box, nodes, ports, viewBox, wires } from "./workflow.ts";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const { width: w, height: h } = box;
const gate = nodes.find((n) => n.id === "gate")!;
const first = wires[0]!;
---

<div class="home-hero not-content">
  {/* Before first paint, so the animation's starting state never flashes the finished graph. */}
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches)
      document.currentScript.parentElement.classList.add("motion");
  </script>
  <div class="copy">
    {/* Starlight's own id for the page title (PAGE_TITLE_ID), which the skip link targets. */}
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ icon, link, text, variant = "primary" }) => (
            <a class={`sl-link-button not-content action ${variant}`} href={link}>
              {text}
              {icon && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              )}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="stage">
    <div class="board" data-workflow>
      <div class="board-bar">
        <span class="pill" aria-hidden="true">Workspace · acme</span>
        <span class="pill" aria-hidden="true">Project · Billing</span>
        <span class="grow"></span>
        <span class="status" data-status aria-hidden="true">ENG-12 · waiting to start</span>
        <button type="button" class="pause" data-pause aria-pressed="false" hidden>Pause</button>
      </div>
      <div class="graph" data-graph>
        <svg
          viewBox={`0 0 ${viewBox.width} ${viewBox.height}`}
          role="img"
          aria-label="An Issue handed to deevy in Linear is routed to the Agent builder, which stops at its plan Checkpoint's Gate. A Human approves from deevy, a comment on the record or Slack; the pull request opens and Linear hears back."
        >
          <g class="wires">
            {
              wires.map((wire) => (
                <path d={wire.d} class:list={["wire", { loop: wire.loop }]} data-wire={wire.key} />
              ))
            }
          </g>
          <g class="nodes">
            {
              nodes.map((n) => (
                <g class={`node ${n.kind}`} transform={`translate(${n.x} ${n.y})`} data-node={n.id}>
                  <rect class="box" width={w} height={h} rx="12" />
                  {(n.kind === "human" || n.kind === "tool") && (
                    <circle class="icon" cx="26" cy="32" r="11" />
                  )}
                  {n.kind === "agent" && (
                    <rect class="icon" x="15" y="21" width="22" height="22" rx="5" />
                  )}
                  {n.kind === "gate" && (
                    <rect class="icon" x="24" y="18" width="4" height="28" rx="2" />
                  )}
                  {n.kind === "deevy" && (
                    <svg x="14" y="18" width="24" height="28" viewBox={markBox}>
                      <path d={disc} class="disc" />
                      <path d={bar} class="bar" />
                    </svg>
                  )}
                  <text x="50" y="29" class="title">
                    {n.title}
                  </text>
                  <text x="50" y="47" class="detail">
                    {n.detail}
                  </text>
                </g>
              ))
            }
          </g>
          <g class="ports">{ports.map(([x, y]) => <circle cx={x} cy={y} r="4" />)}</g>
          <circle class="halo" r="12" cx={gate.x + w / 2} cy={gate.y + h} />
          <circle class="packet" r="6" cx={first.from[0]} cy={first.from[1]} />
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(1.5rem, 6vw, 4.5rem);
    font-family: var(--home-face);
    overflow-x: clip;
  }
  .home-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 16rem;
    width: min(70rem, 120vw);
    height: 40rem;
    transform: translateX(-50%);
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--primary) 20%, transparent),
      transparent
    );
    pointer-events: none;
  }
  .home-hero .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .home-hero h1 {
    margin: 0;
    max-width: 16ch;
    font-family: var(--home-face);
    font-size: clamp(2.5rem, 6.2vw, 5.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--foreground);
    text-wrap: balance;
  }
  .home-hero h1 :global(.gate) {
    color: var(--gate-display);
  }
  .home-hero .tagline {
    margin: 0;
    max-width: 36rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .home-hero .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }
  /* theme.css colours .sl-link-button by variant; this is its shape. */
  .home-hero .action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border: 1px solid transparent;
    font-size: 1rem;
    line-height: 1.1875;
    text-decoration: none;
  }
  .home-hero .action svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stage {
    position: relative;
    width: 100%;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    perspective: 1400px;
  }
  /* --flat is 1 at rest and without a script; the script tilts the board back and flattens it on scroll. */
  .board {
    --flat: 1;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in oklab, var(--card) 92%, var(--background));
    box-shadow: 0 60px 140px -50px color-mix(in oklab, var(--primary) 45%, transparent);
    overflow: clip;
    transform-origin: 50% 0;
    transform: rotateX(calc((1 - var(--flat)) * 28deg)) scale(calc(0.94 + var(--flat) * 0.06));
  }
  .board-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.25rem;
    padding: 0.625rem 0.75rem 0.625rem 1rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--home-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
  .pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.125rem 0.625rem;
  }
  .grow {
    flex: 1;
  }
  .pause {
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    cursor: pointer;
  }
  .pause:hover {
    border-color: var(--ring);
  }
  .graph {
    overflow-x: auto;
  }
  .graph > svg {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
  }

  .wire {
    fill: none;
    stroke: color-mix(in oklab, var(--muted-foreground) 55%, transparent);
    stroke-width: 1.5;
    transition: stroke 0.3s;
  }
  .wire.loop {
    stroke-dasharray: 4 6;
  }
  .wire.lit {
    stroke: var(--human);
  }
  .box {
    fill: var(--background);
    stroke: var(--border);
    transition:
      stroke 0.3s,
      fill 0.3s;
  }
  .gate .box {
    fill: color-mix(in oklab, var(--gate) 10%, var(--background));
    stroke: var(--gate);
  }
  .gate.asking .box {
    fill: color-mix(in oklab, var(--gate) 22%, var(--background));
  }
  .node.on .box {
    stroke: var(--human);
  }
  .icon {
    fill: none;
    stroke-width: 2;
  }
  .human .icon {
    stroke: var(--human);
  }
  .agent .icon {
    stroke: var(--agent);
  }
  .gate .icon {
    fill: var(--gate);
    stroke: none;
  }
  .tool .icon {
    stroke: var(--muted-foreground);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
  .disc {
    fill: var(--human);
  }
  .bar {
    fill: var(--agent);
  }
  .title {
    font-family: var(--home-face);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    fill: var(--foreground);
  }
  .detail {
    font-family: var(--home-mono);
    font-size: 11px;
    fill: var(--muted-foreground);
  }
  /* On the Gate's tint the muted grey reads under 4.5:1; the ink does not. */
  .gate .detail {
    fill: var(--foreground);
  }
  .ports circle {
    fill: var(--card);
    stroke: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
    stroke-width: 1.5;
  }
  .packet {
    fill: var(--human);
    opacity: 0;
  }
  .packet[data-kind="agent"] {
    fill: var(--agent);
  }
  .packet[data-kind="done"] {
    fill: var(--state-done);
  }
  .halo {
    fill: none;
    stroke: var(--gate);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /*
   * The starting state, set before first paint (the inline script above) and
   * handed over by the module script, which draws everything in. Should that
   * script never run, the graph shows itself after three seconds anyway.
   */
  .motion .board {
    --flat: 0;
  }
  .motion :is(.wire, .node, .ports) {
    opacity: 0;
    animation: home-reveal 0.4s 3s forwards;
  }
  @keyframes home-reveal {
    to {
      opacity: 1;
    }
  }

  /* A phone sees the graph larger, scrolled to follow the Run, and never tilted. */
  @media (max-width: 50rem) {
    .board {
      transform: none;
    }
    .graph > svg {
      min-width: 900px;
    }
  }
</style>

<script>
  import { packetKind, route, status as statusOf } from "./workflow.ts";

  const board = document.querySelector<HTMLElement>("[data-workflow]");
  if (board && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) animate(board);

  function animate(board: HTMLElement) {
    const hero = board.closest<HTMLElement>(".home-hero")!;
    const svg = board.querySelector<SVGSVGElement>(".graph > svg")!;
    const graph = board.querySelector<HTMLElement>("[data-graph]")!;
    const status = board.querySelector<HTMLElement>("[data-status]")!;
    const pause = board.querySelector<HTMLButtonElement>("[data-pause]")!;
    const packet = svg.querySelector<SVGCircleElement>(".packet")!;
    const halo = svg.querySelector<SVGCircleElement>(".halo")!;
    const wires = new Map(
      [...svg.querySelectorAll<SVGPathElement>("[data-wire]")].map((p) => [p.dataset.wire!, p]),
    );
    const node = (id: string) => svg.querySelector<SVGGElement>(`[data-node="${id}"]`)!;
    const fading = [...svg.querySelectorAll<SVGElement>(".node, .ports")];

    // The board leans back until it scrolls into view, then lies flat.
    const stage = board.parentElement!;
    let queued = false;
    const flatten = () => {
      queued = false;
      const top = stage.getBoundingClientRect().top;
      const vh = window.innerHeight;
      const flat = Math.min(1, Math.max(0, (vh * 0.85 - top) / (vh * 0.6)));
      board.style.setProperty("--flat", flat.toFixed(3));
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(flatten);
    };
    flatten();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);

    // The Run walks only while the board is on screen, the tab is visible and nobody paused it.
    let onScreen = true;
    let paused = false;
    let wake: (() => void) | null = null;
    const running = () => onScreen && !document.hidden && !paused;
    const check = () => {
      if (running() && wake) {
        wake();
        wake = null;
      }
    };
    const ready = () =>
      running() ? Promise.resolve() : new Promise<void>((resolve) => (wake = resolve));
    new IntersectionObserver(([entry]) => {
      onScreen = entry!.isIntersecting;
      check();
    }).observe(board);
    document.addEventListener("visibilitychange", check);
    let current: Animation | null = null;
    pause.hidden = false;
    pause.addEventListener("click", () => {
      paused = !paused;
      pause.textContent = paused ? "Play" : "Pause";
      pause.setAttribute("aria-pressed", String(paused));
      if (paused) current?.pause();
      else current?.play();
      check();
    });

    // A finger on the graph takes over its scrolling for a while; otherwise it follows the Run.
    let manualUntil = 0;
    for (const type of ["pointerdown", "wheel", "touchstart"])
      graph.addEventListener(type, () => (manualUntil = performance.now() + 4000), { passive: true });
    const follow = (x: number) => {
      if (graph.scrollWidth <= graph.clientWidth || performance.now() < manualUntil) return;
      const scale = svg.clientWidth / svg.viewBox.baseVal.width;
      const target = x * scale - graph.clientWidth / 2;
      graph.scrollLeft += (target - graph.scrollLeft) * 0.08;
    };

    // Hand over from the inline starting state: everything hidden, then drawn in once, in order.
    const all = [...wires.values()];
    for (const path of all) {
      const length = path.getTotalLength();
      path.style.strokeDasharray = `${length} ${length}`;
      path.style.strokeDashoffset = `${length}`;
    }
    for (const element of fading) element.style.opacity = "0";
    hero.classList.remove("motion");
    fading.forEach((element, i) => {
      element
        .animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, delay: i * 50, fill: "forwards" })
        .finished.then(() => {
          element.style.opacity = "";
          element.getAnimations().forEach((a) => a.cancel());
        });
    });
    const drawn = all.map(
      (path, i) =>
        path.animate([{ strokeDashoffset: path.getTotalLength() }, { strokeDashoffset: 0 }], {
          duration: 450,
          delay: 300 + i * 70,
          easing: "ease-in-out",
          fill: "forwards",
        }).finished,
    );
    Promise.all(drawn).then(() => {
      for (const path of all) {
        path.getAnimations().forEach((a) => a.cancel());
        path.style.strokeDasharray = "";
        path.style.strokeDashoffset = "";
      }
      void walk();
    });

    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    function travel(path: SVGPathElement): Promise<void> {
      const length = path.getTotalLength();
      const duration = Math.max(500, (length / 280) * 1000);
      let elapsed = 0;
      let last = performance.now();
      return new Promise((resolve) => {
        const step = (now: number) => {
          if (running()) elapsed += now - last;
          last = now;
          const t = Math.min(1, elapsed / duration);
          const point = path.getPointAtLength(ease(t) * length);
          packet.setAttribute("cx", String(point.x));
          packet.setAttribute("cy", String(point.y));
          follow(point.x);
          if (t < 1) requestAnimationFrame(step);
          else resolve();
        };
        requestAnimationFrame(step);
      });
    }

    // One Run at a time: in, a wait at the Gate, out through a channel the last Run did not take.
    let lastChannel = "";
    async function walk() {
      for (;;) {
        await ready();
        const channels = Object.keys(route.channels).filter((c) => c !== lastChannel);
        const channel = channels[Math.floor(Math.random() * channels.length)]!;
        lastChannel = channel;
        const legs = [...route.in, ...route.channels[channel]!, ...route.out];
        packet.style.opacity = "1";
        for (const key of legs) {
          await ready();
          const path = wires.get(key)!;
          if (key.startsWith("gate>")) {
            status.textContent = "ENG-12 · waiting at the Gate";
            node("gate").classList.add("asking");
            current = halo.animate(
              [
                { opacity: 0, transform: "scale(1)" },
                { opacity: 1, transform: "scale(2)" },
              ],
              { duration: 600, iterations: 4, direction: "alternate" },
            );
            if (paused) current.pause();
            await current.finished;
            current = null;
            node("gate").classList.remove("asking");
            node(channel).classList.add("on");
          }
          packet.dataset.kind = packetKind(key);
          status.textContent = `ENG-12 · ${statusOf[key]}`;
          path.classList.add("lit");
          await travel(path);
          path.classList.remove("lit");
          if (key.startsWith("gate>")) node(channel).classList.remove("on");
        }
        packet.style.opacity = "0";
        await new Promise((resolve) => setTimeout(resolve, 600));
      }
    }
  }
</script>
