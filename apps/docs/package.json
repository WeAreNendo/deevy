{
  "name": "@deevy/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.ts",
    "serve": "node scripts/sync.ts && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/sync.ts && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check:workers": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/starlight": "catalog:",
    "@deevy/design": "workspace:*",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@types/node": "catalog:",
    "astro": "catalog:",
    "github-slugger": "catalog:",
    "starlight-links-validator": "catalog:",
    "starlight-openapi": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
